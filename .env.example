# Copy to .env and fill in. `.env` is git-ignored.
# Everything deterministic (catalog, pricing, storage, portal) runs with none of these set;
# the LLM reviewer summary then falls back to a deterministic summary, and traces aren't sent.

# --- LLM (intake + reviewer summary) ---
OPENAI_API_KEY=sk-...
# Optional: override the default model without touching code.
OPENAI_MODEL=gpt-4.1-mini

# --- Langfuse tracing (optional) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Portal ---
# Name shown as the default reviewer / queue owner for new cases.
DEFAULT_REVIEWER=Sarah
# Optional passphrase gate for a public Streamlit deployment (off when unset).
# ACCESS_CODE=
